<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tcursor</AssemblyName>
    <RootNamespace>Tcursor</RootNamespace>
    <Version>3.13</Version>
    <InformationalVersion>3.13</InformationalVersion>
    <AssemblyTitle>Tcursor</AssemblyTitle>
    <Product>Tcursor</Product>
    <Description>输入法状态光标提示：在光标旁显示输入法状态符号（GPL-3.0）</Description>
    <Copyright>© 2026 Crucialmer（GPL-3.0）</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\default-app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);WFO5001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\default-app.png" />
    <EmbeddedResource Include="Assets\default-app-paused.png" />
  </ItemGroup>

</Project>
